# BotTalk Configuration
#
# Copy this to .env and set your credentials:
#   cp .env.template .env
#
# BotTalk uses uv which loads .env automatically.  Or pass variables directly:
#   BOTTALK_API_KEY=secret uv run python main.py

# ── Bot API auth ──────────────────────────────────────────────────────────
# Bots authenticate with this key via Authorization: Bearer <key>
# Generate one:  python3 -c "import secrets; print('bt_' + secrets.token_hex(24))"
BOTTALK_API_KEY=

# ── Web UI login (humans) ─────────────────────────────────────────────────
# Username and password for the Bootstrap 5 web interface at /
# If unset, defaults to "admin" with a random password printed at startup.
# BOTTALK_WEB_USERNAME=admin
# BOTTALK_WEB_PASSWORD=your_password_here

# Secret key for signing session cookies (auto-generated if unset)
# BOTTALK_SECRET_KEY=

# ── Server ────────────────────────────────────────────────────────────────
# BOTTALK_HOST=127.0.0.1
# BOTTALK_PORT=8000

# Enable auto-reload for development:  BOTTALK_RELOAD=1

# ── Database ──────────────────────────────────────────────────────────────
# Default: bottalk.bson in the project root directory
# BOTTALK_DB_PATH=/path/to/bottalk.bson
